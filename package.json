{
  "name": "curve-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first, offline desktop tool for table-driven curve visualization.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --filter @curve/desktop dev",
    "build": "pnpm --filter @curve/desktop build",
    "package": "pnpm build && pnpm --filter @curve/desktop package",
    "postinstall": "node scripts/install-electron.mjs",
    "lint": "eslint . --max-warnings=0 && pnpm lint:boundaries",
    "lint:boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "pnpm build && tsx scripts/gen-100k.ts --workspace bench/.fixtures/100k-workspace && playwright test --config apps/desktop/playwright.config.ts",
    "bench": "node --expose-gc --import tsx scripts/bench.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@curve/app-core": "workspace:*",
    "@curve/chart-model": "workspace:*",
    "@curve/domain": "workspace:*",
    "@curve/persistence": "workspace:*",
    "@curve/table-engine": "workspace:*",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "iconv-lite": "^0.7.3",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
