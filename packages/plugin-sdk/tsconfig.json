{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist-types",
    "tsBuildInfoFile": "dist-types/tsconfig.tsbuildinfo",
    // `ImporterDef.parse` receives an `AbortSignal` (SPEC §14.2); the SDK is
    // type-only and runs in the renderer, so the DOM lib gives that type
    // without adding Node globals or a runtime dependency.
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../domain" }]
}
