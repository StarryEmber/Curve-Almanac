{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "baseUrl": ".",
    "paths": {
      "@curve/domain": ["packages/domain/src/index.ts"],
      "@curve/table-engine": ["packages/table-engine/src/index.ts"],
      "@curve/chart-model": ["packages/chart-model/src/index.ts"],
      "@curve/chart-echarts": ["packages/chart-echarts/src/index.ts"],
      "@curve/persistence": ["packages/persistence/src/index.ts"],
      "@curve/plugin-sdk": ["packages/plugin-sdk/src/index.ts"],
      "@curve/ui": ["packages/ui/src/index.ts"],
      "@curve/app-core": ["packages/app-core/src/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "useUnknownInCatchVariables": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "sourceMap": false,
    "types": []
  }
}
