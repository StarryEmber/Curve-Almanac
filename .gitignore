# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-types/
out/
release/
*.tsbuildinfo

# Test output
coverage/
playwright-report/
test-results/

# Benchmarks (regenerated by `pnpm bench`; CI uploads report.json as an artifact).
# The regression baseline is the one file that must be committed.
bench/*
!bench/README.md
!bench/baseline.json

# Generated import fixtures (>1 MB; see fixtures/csv/README.md)
fixtures/csv/gbk-100k.csv

# Tooling caches
.vite/
.eslintcache

# Chromium/Electron runtime logs (created in the process cwd when logging is on)
debug.log

# Local environment
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/*

# 历史 E2E 截图目录（T10）：保留忽略规则，防止本地重写或误提交。
docs/reports/m0/*.png
