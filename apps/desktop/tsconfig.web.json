{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "outDir": "dist-types/web",
    "tsBuildInfoFile": "dist-types/web/tsconfig.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx"
  },
  "references": [
    { "path": "../../packages/domain" },
    { "path": "../../packages/table-engine" },
    { "path": "../../packages/persistence" },
    { "path": "../../packages/app-core" },
    { "path": "../../packages/chart-model" },
    { "path": "../../packages/chart-echarts" },
    { "path": "../../packages/plugin-sdk" },
    { "path": "../../plugins/plugin-sample" },
    { "path": "../../packages/ui" }
  ],
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/shared/**/*.ts"]
}
